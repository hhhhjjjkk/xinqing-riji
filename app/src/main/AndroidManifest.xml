<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机后恢复提醒调度 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 12+ 使用精确闹钟（整点提醒）需要 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 让闹钟在 Doze 模式下也能触发 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 跳转到「忽略电池优化」设置页需要 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ============ 关于「自启动」================
         先纠正一个流传很广的误解（本项目早期版本也写错过）：

         **Android 没有「自启动权限」**。它不在 AOSP 的权限模型里，不存在任何
         可以用 <uses-permission> 声明的名字，也不存在任何可以在运行时申请的 API。
         任何在清单里声明 miui.* / vivo.* / samsung.* 之类「厂商自启动权限」的写法，
         对自启动开关**没有任何作用**——系统会直接忽略未知权限名；
         而且自启动列表也从来不是按清单声明筛选的（它列出的是已安装的用户应用）。

         真正决定能否自启动的是这两件事：
         1. RECEIVE_BOOT_COMPLETED（普通权限，安装即授予）—— 决定能否收到开机广播；
         2. 厂商「手机管家 / 安全中心」里的自启动开关 —— 只能由用户在该页面手动打开。

         唯一例外是华为 / 荣耀：其 systemmanager 暴露了 ContentProvider，
         应用可以通过它真正读写自己的自启动状态（见 Reminder.huaweiSetAutoStart）。
         下面这条厂商权限是为了访问那个 provider 而保留的。

         历史上声明过、但确认无效并已删除的（留着只会误导后来的人）：
           miui.permission.USE_INTERNAL_GENERAL_API
           com.oppo.launcher.permission.READ_SETTINGS / WRITE_SETTINGS
           com.vivo.permission.BACKGROUND_START
           com.samsung.android.permission.KEEP_ALIVE -->
    <!-- 华为 / 荣耀：访问 systemmanager 的启动管理 provider 需要 -->
    <uses-permission android:name="com.huawei.permission.external_app_settings.USE_COMPONENT" />

    <!-- ============ 包可见性（Android 11+ 必须） ============
         Android 11 引入 package visibility：resolveActivity() 对未在 <queries>
         声明的其他应用一律返回 null。此前没有这一段，导致 Android 11+ 上
         openAutoStartSettings() 的所有厂商候选全部解析失败，
         永远退回普通的「应用详情页」——「跳转自启动管理页」功能整体失效。
         这里按 Reminder.kt 候选清单逐一声明包名。 -->
    <queries>
        <!-- 小米 / Redmi -->
        <package android:name="com.miui.securitycenter" />
        <!-- 华为 / 荣耀 -->
        <package android:name="com.huawei.systemmanager" />
        <!-- OPPO / 一加 / realme -->
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.oneplus.security" />
        <!-- vivo / iQOO -->
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <!-- 三星 -->
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.samsung.android.sm_cn" />
        <!-- 魅族 -->
        <package android:name="com.meizu.safe" />
        <!-- 兜底：系统设置（应用详情页） -->
        <package android:name="com.android.settings" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="心情日记"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoodDiary">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 整点提醒 + 开机/升级后恢复调度 -->
        <receiver
            android:name=".ReminderReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mooddiary.app.ACTION_REMINDER_TICK" />
                <action android:name="com.mooddiary.app.ACTION_QUICK_MOOD" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
