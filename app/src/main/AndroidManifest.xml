<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机后恢复提醒调度 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 12+ 使用精确闹钟（整点提醒）需要 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 让闹钟在 Doze 模式下也能触发 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 跳转到「忽略电池优化」设置页需要 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ============ 自启动 / 后台运行 ============
         Android 标准里并没有「自启动权限」这个可申请项，它是国内 ROM
         （小米、华为、OPPO、vivo、三星等）自行加入的管控开关。

         关键点：这些 ROM 的「自启动管理」列表只收录**声明了对应厂商私有权限**
         的应用；没有声明的应用在列表里会显示为灰色不可点，甚至压根不出现——
         这正是「跳到设置页却无法开启自启动」的原因。

         下列权限在各厂商 ROM 上按普通权限处理，安装即授予、无需运行时申请；
         在普通 AOSP / 类原生设备上会被系统直接忽略，不影响安装与运行。 -->
    <!-- 小米 / Redmi：自启动管理页会检查该权限 -->
    <uses-permission android:name="miui.permission.USE_INTERNAL_GENERAL_API" />
    <!-- 华为 / 荣耀：启动管理 / 应用启动记录 -->
    <uses-permission android:name="com.huawei.permission.external_app_settings.USE_COMPONENT" />
    <!-- OPPO / 一加 / realme：允许后台运行 -->
    <uses-permission android:name="com.oppo.launcher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.oppo.launcher.permission.WRITE_SETTINGS" />
    <!-- vivo / iQOO：后台高耗电 / 自启动 -->
    <uses-permission android:name="com.vivo.permission.BACKGROUND_START" />
    <!-- 三星：应用保持活动 -->
    <uses-permission android:name="com.samsung.android.permission.KEEP_ALIVE" />

    <!-- ============ 包可见性（Android 11+ 必须） ============
         Android 11 引入 package visibility：resolveActivity() 对未在 <queries>
         声明的其他应用一律返回 null。此前没有这一段，导致 Android 11+ 上
         openAutoStartSettings() 的所有厂商候选全部解析失败，
         永远退回普通的「应用详情页」——「跳转自启动管理页」功能整体失效。
         这里按 Reminder.kt 候选清单逐一声明包名。 -->
    <queries>
        <!-- 小米 / Redmi -->
        <package android:name="com.miui.securitycenter" />
        <!-- 华为 / 荣耀 -->
        <package android:name="com.huawei.systemmanager" />
        <!-- OPPO / 一加 / realme -->
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.oneplus.security" />
        <!-- vivo / iQOO -->
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <!-- 三星 -->
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.samsung.android.sm_cn" />
        <!-- 魅族 -->
        <package android:name="com.meizu.safe" />
        <!-- 兜底：系统设置（应用详情页） -->
        <package android:name="com.android.settings" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="心情日记"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoodDiary">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 整点提醒 + 开机/升级后恢复调度 -->
        <receiver
            android:name=".ReminderReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mooddiary.app.ACTION_REMINDER_TICK" />
                <action android:name="com.mooddiary.app.ACTION_QUICK_MOOD" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
