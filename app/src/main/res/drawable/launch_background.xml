<?xml version="1.0" encoding="utf-8"?>
<!-- 冷启动占位：与 MainActivity 首屏渐变同构
     （0% → launch_bg_top、40% → launch_bg_bottom、100% → launch_bg_bottom），
     从点击图标到 Compose 首帧之间无缝接力，消除白屏闪烁 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:type="linear"
        android:startColor="@color/launch_bg_top"
        android:centerColor="@color/launch_bg_bottom"
        android:endColor="@color/launch_bg_bottom"
        android:centerX="0.4" />
</shape>
