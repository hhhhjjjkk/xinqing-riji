<?xml version="1.0" encoding="utf-8"?>
<!--
  通知卡片容器：圆角 + 极细边框，让内容区成为一个整体卡片。
  填充色与描边色用 @color 引用，随 system dark mode 在
  values/（浅）与 values-night/（深）之间自动切换。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/notif_card_bg" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="@color/notif_card_border" />
</shape>
