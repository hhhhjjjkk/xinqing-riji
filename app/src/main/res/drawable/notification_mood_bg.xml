<?xml version="1.0" encoding="utf-8"?>
<!--
  通知里心情按钮的「药丸」底：填充 + 极细描边。
  与卡片背景区分开，像一个可点的小按钮。
  填充/描边色用 @color 引用，随 system dark mode 自动切换。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/notif_btn_fill" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/notif_btn_border" />
</shape>
