<?xml version="1.0" encoding="utf-8"?>
<!--
  通知「折叠态」的紧凑布局（RemoteViews）。

  折叠态的通知内容区高度只有约 64dp，若直接复用展开态的高布局
  （标题 + 副标题 + 按钮区）会被系统裁掉，表现为部分心情图标看不见。
  因此折叠态这里只放一行表情，高度可控。

  5 个槽位的表情与点击目标由 Reminder.sendNotification 运行时填充。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/c_btn_0"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/notification_mood_bg">

        <TextView
            android:id="@+id/c_emoji_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/c_btn_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/notification_mood_bg">

        <TextView
            android:id="@+id/c_emoji_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/c_btn_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/notification_mood_bg">

        <TextView
            android:id="@+id/c_emoji_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/c_btn_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/notification_mood_bg">

        <TextView
            android:id="@+id/c_emoji_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/c_btn_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/notification_mood_bg">

        <TextView
            android:id="@+id/c_emoji_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:singleLine="true" />
    </LinearLayout>
</LinearLayout>
