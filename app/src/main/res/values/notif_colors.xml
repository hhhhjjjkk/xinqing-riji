<?xml version="1.0" encoding="utf-8"?>
<!-- 通知文字颜色（浅色通知面板）：用深色文字，否则白字在浅底上看不见 -->
<resources>
    <color name="notif_title">#FF1B1B1F</color>
    <color name="notif_subtitle">#991B1B1F</color>
    <color name="notif_label">#A61B1B1F</color>
    <color name="notif_btn_bg">#14000000</color>
    <!-- 卡片头部的小字（应用名），比正文更浅 -->
    <color name="notif_header">#661B1B1F</color>
    <!-- 卡片底部引导小字 -->
    <color name="notif_footer">#8A1B1B1F</color>

    <!-- 卡片容器底色（浅色：接近白色的半透明）与描边 -->
    <color name="notif_card_bg">#F2FFFFFF</color>
    <color name="notif_card_border">#1A1B1F</color>
    <!-- 心情按钮底色与描边（浅色：白底细灰边，从卡片底色上浮起来） -->
    <color name="notif_btn_fill">#E6FFFFFF</color>
    <color name="notif_btn_border">#1A000000</color>
</resources>
