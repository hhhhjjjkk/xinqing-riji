<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MoodDiary" parent="android:style/Theme.DeviceDefault.NoActionBar" />

    <!-- 冷启动占位主题：仅 MainActivity 使用。
         windowBackground 与首屏渐变一致（见 drawable/launch_background.xml），
         Compose 首帧就绪后无缝接力，启动期间不再白屏闪烁 -->
    <style name="Theme.MoodDiary.Launch" parent="Theme.MoodDiary">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
